safe_rm() {
    local files=("$@")
    echo "Files to be deleted:"
    printf "  %s\n" "$files"
    read -p "Are you sure you want to delete these? (y/N) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        command rm -v -- "$@"
    else
        echo "Deletion cancelled."
    fi
}
alias rm='safe_rm'
